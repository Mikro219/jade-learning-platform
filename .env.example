# Every environment variable the platform reads (plan V4). Copy nothing from here by hand:
# `pnpm env:init` writes `.env` with freshly generated secrets (mode 600). Secrets are left empty
# here and have no default anywhere, in any APP_ENV. `.env` is read only outside production, by
# vite.config.ts, playwright.config.ts and the tools (tools/load-env.ts); `node build` reads none.

# --- The app (src/lib/server/config) ---

# Read by the app. Not a secret. One of development, test, staging, production; required, no
# default. When NODE_ENV is production (the image), only staging or production is accepted.
APP_ENV=

# Read by the app and the migration tool. SECRET. A postgres:// URL for role jade_app (the app
# role; it never holds the owner's credentials). Written by `pnpm env:init` from
# JADE_APP_DB_PASSWORD and JADE_DEV_DB_PORT.
DATABASE_URL=

# Read by the app. SECRET. The kit-code HMAC pepper: at least 43 characters of A-Za-z0-9_+/=-
# (32 random bytes in base64, base64url or hex). Generate with `pnpm env:init`.
CODE_PEPPER=

# Read by the app. SECRET. Signs device sessions (used from Phase 3): at least 43 characters of
# A-Za-z0-9_+/=- (32 random bytes). Generate with `pnpm env:init`.
SESSION_SECRET=

# Read by the app. Not a secret. One of debug, info, warn, error; default info.
LOG_LEVEL=info

# --- The migration tool (tools/db/, `pnpm db:migrate` and `pnpm db:reset`) ---

# Read by the migration tool only, never by the app (the app container never receives it).
# SECRET. A postgres:// URL for role jade_owner, which owns the database and runs migrations, for
# the same host, port and database as DATABASE_URL. Written by `pnpm env:init` from
# JADE_OWNER_DB_PASSWORD and JADE_DEV_DB_PORT.
MIGRATION_DATABASE_URL=

# --- The development database (written by `pnpm env:init`) ---

# Read by compose.dev.yml. SECRET. The jade_owner role's password: the database's superuser in
# the Compose container, which MIGRATION_DATABASE_URL carries. Generated, [A-Za-z0-9_-] only. In
# the `ci` profile it is taken from the job's environment and must contain test-only.
JADE_OWNER_DB_PASSWORD=

# SECRET. The jade_app role's password, which DATABASE_URL carries; `pnpm db:migrate` creates the
# role with it, or sets it when the role's login is refused. Generated, [A-Za-z0-9_-] only, so it
# sits in a URL unescaped.
JADE_APP_DB_PASSWORD=

# Read by compose.dev.yml. Not a secret. The host port of the development database on 127.0.0.1:
# 5432 when free, else a free port, so a second worktree gets a database of its own.
JADE_DEV_DB_PORT=

# Read by tools/compose.ts (`pnpm db:up`, `pnpm db:down`). Not a secret. Leave unset: the project
# is then jade-dev-<hash of this checkout's path>. The bugfix gates and the clean-clone check
# export their own.
COMPOSE_PROJECT_NAME=

# --- The local production stack (compose.prod.yml; `pnpm stack:up`, written by `pnpm env:init`) ---
# compose.prod.yml builds both database URLs itself, with host `db`, from JADE_OWNER_DB_PASSWORD
# and JADE_APP_DB_PASSWORD, and reads none of APP_ENV, DATABASE_URL, MIGRATION_DATABASE_URL or
# JADE_DEV_DB_PORT. On a VM, `pnpm env:init --profile stack` writes these and the secrets only.

# Read by compose.prod.yml (the app's and the migrate service's APP_ENV). Not a secret. staging or
# production; required. `production` in a checkout, `staging` on the staging VM.
JADE_STACK_APP_ENV=

# Read by compose.prod.yml (Caddy's site address). Not a secret. The host name Caddy serves and
# gets a certificate for: `localhost` (Caddy's internal CA) in a checkout, the real name on a VM.
SITE_ADDRESS=

# Read by compose.prod.yml. Not a secret. The host port published to Caddy's port 80; required,
# no default (80 unless `pnpm env:init --http-port` says otherwise).
JADE_HTTP_PORT=

# Read by compose.prod.yml. Not a secret. The host port published to Caddy's port 443; required,
# no default (443 unless `pnpm env:init --https-port` says otherwise).
JADE_HTTPS_PORT=

# Read by compose.prod.yml (the app's ORIGIN). Not a secret. https://<SITE_ADDRESS>, with
# :<JADE_HTTPS_PORT> appended unless that port is 443.
JADE_ORIGIN=

# Read by compose.prod.yml. Not a secret. The app image the `app` and `migrate` services run. Leave
# unset: `pnpm stack:up` sets jade-app:local-<hash of this checkout's path>, the infra tests their
# run's own tag; unset, the bare `docker compose -f compose.prod.yml up` uses jade-app:local.
JADE_IMAGE=

# --- The infra tests (`pnpm test:infra`, tests/infra) ---

# Read by the infra tests' global setup. Not a secret. Leave unset: each run then takes 16 random
# hex digits. CI sets the workflow run's id and attempt.
JADE_INFRA_RUN_ID=

# Read by the infra tests' global setup. Not a secret. Leave unset: the run's image tag is removed
# at the end. CI sets 1 and the tag is written to test-results/infra-image-tag.txt instead.
JADE_INFRA_KEEP_IMAGE=

# Read by the infra tests' global setup (tools/compose.ts imageCacheArgs). Not a secret. Leave
# unset. CI's image job sets gha, which adds `--set app.cache-from=type=gha` and
# `--set app.cache-to=type=gha,mode=max` to `pnpm ci:image`; any other value is refused.
JADE_CI_IMAGE_CACHE=

# Read by docker buildx and Compose builds. Not a secret. Leave unset to use the current buildx
# builder; the infra tests set it to the builder their global setup used.
BUILDX_BUILDER=

# --- CI (tools/ci, .github/workflows/ci.yml) ---

# Set by the CI host (true on GitHub Actions); leave unset on a development machine. With it,
# tools/ci/base-ref.ts refuses to run without JADE_CI_BASE, and pnpm ci:compat installs the base
# with --no-runtime, since the runner's Node from .nvmrc runs everything. Not a secret.
CI=

# Set by the workflow from the event: the pull request's base commit, or the commit main pointed
# at before the push (forty zeros: no base). Leave unset locally, where the base is the merge base
# of HEAD and main. Not a secret.
JADE_CI_BASE=

# --- The test harness (tests/support) ---

# Read by the integration tests' global setup. Not a secret. Leave unset: each run then builds
# and drops its own template database. The CI compatibility run (jade-xu0) names a database
# migrated by a newer runner, which the setup checks and leaves in place.
JADE_TEST_TEMPLATE=

# --- The Node adapter (read by `node build`) ---

# Not a secret. The address the server binds; the adapter defaults to 0.0.0.0.
HOST=

# Not a secret. The port the server listens on; the adapter defaults to 3000.
PORT=

# Not a secret. The public origin of the site, for example https://localhost.
ORIGIN=

# --- Build and runtime mode ---

# Not a secret. Set to production by the image; leave unset on a development machine, where
# tools/load-env.ts reads .env only while it is not production.
NODE_ENV=

# Read by vite.config.ts at build time, and by compose.prod.yml as the image's build argument
# (default dev). Not a secret. The version the app reports in /healthz.
APP_VERSION=
