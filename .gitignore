
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Python bytecode caches (they would otherwise land in planloop snapshots and bugfix patches)
__pycache__/

# App build, test and gate output (jade-h8i)
node_modules/
.svelte-kit/
build/
test-results/
playwright-report/
blob-report/
coverage/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Env files hold secrets (plan V4, INV4); only the documented example is tracked (jade-8v4)
.env
.env.*
!.env.example
