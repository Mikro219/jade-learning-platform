{
	"name": "jade",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": "24.22.3",
		"pnpm": ">=12.21.0 <13"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.22.3",
			"onFail": "download"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "prettier --check . && eslint . --max-warnings 0",
		"format": "prettier --write .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run --project '!infra'",
		"e2e": "playwright test",
		"ci:clean-clone": "bash tools/ci/clean-clone.sh"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-node": "6.0.2",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	}
}
